    "url": {{ item.url | relative_url | jsonify }},
    "type": "Teaching",
    "excerpt": {{ item.excerpt | default: item.content | strip_html | strip_newlines | truncate: 180 | jsonify }},
    "content": {{ item.content | strip_html | strip_newlines | jsonify }}
  }
  {% assign first_item = false %}
{% endfor %}


